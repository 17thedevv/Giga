# Giga API — Local Environment Configuration Example
# Copy to .env for local overrides (never commit secrets)

PORT=3000
NODE_ENV=development

# Serve the reviewed apps/web/dist bundle from the API origin (build both apps first).
# Avoids buffering POST SSE through a static-site proxy. Disabled by default.
SERVE_WEB=false

# One server-only Gemini model; never use VITE_ variables for these settings.
# Production defaults Chat on; set CHAT_ENABLED=false to explicitly disable it.
# Development/tests stay offline unless enabled or provider fields are supplied.
CHAT_ENABLED=false
# GEMINI_API_KEY=<server-secret>
# CHAT_MODEL_ID=gemini-3.1-flash-lite
# CHAT_MAX_OUTPUT_TOKENS=1024

# Optional Chat-only BYOK: dedicated server secret, canonical base64 of 32 random bytes.
# Missing key disables BYOK (no platform fallback); malformed configured key fails startup.
# CREDENTIAL_ENCRYPTION_KEY=<dedicated-base64-server-secret>

# PostgreSQL connection string
# Local docker compose uses: postgres://giga:giga_dev_password@localhost:5432/giga_dev
DATABASE_URL=postgres://giga:giga_dev_password@localhost:5432/giga_dev

# Cookie & Session Security
# COOKIE_SECURE: Set to true in production (requires HTTPS), false in local HTTP development
COOKIE_SECURE=false

# COOKIE_SAME_SITE: 'lax' (default), 'strict', or 'none' (for cross-site deployments)
COOKIE_SAME_SITE=lax

# Allowed CORS / CSRF origins (comma-separated, scheme + host + optional port)
# Required in production; wildcard '*' is strictly prohibited in production.
# In development, defaults to: http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Dedicated test database connection string (REQUIRED for running tests against real PostgreSQL)
# Must contain 'test' in the database name and NODE_ENV must be set to 'test'.
# Automated tests NEVER execute destructive cleanups against ordinary DATABASE_URL.
TEST_DATABASE_URL=postgres://giga:giga_dev_password@localhost:5432/giga_test

