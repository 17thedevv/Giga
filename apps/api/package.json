{
  "name": "@giga/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "argon2": "^0.45.1",
    "hono": "^4.7.2",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "pg-mem": "^3.0.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
