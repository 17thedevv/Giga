# Placeholders only. Use configure.mjs to generate ignored, distinct local credentials.
# Local HTTP: node infra/docker/configure.mjs --local
# HTTPS: node infra/docker/configure.mjs --origin=https://giga.example --tls-dir=/absolute/certs
COMPOSE_PATH_SEPARATOR=|
COMPOSE_FILE=compose.yaml
PUBLIC_ORIGIN=https://giga.example
TLS_CERT_DIR=<absolute-directory-with-fullchain.pem-and-privkey.pem>
GIGA_BIND_IP=127.0.0.1
IMAGE_TAG=local
DB_PASSWORD_ADMIN=<distinct-random-64-hex>
DB_PASSWORD_MIGRATION=<distinct-random-64-hex>
DB_PASSWORD_API=<distinct-random-64-hex>
DB_PASSWORD_LIFECYCLE=<distinct-random-64-hex>
DB_PASSWORD_QUOTA=<distinct-random-64-hex>
CHAT_ENABLED=false
# Chat opt-in requires a server-only key and reviewed model. Never enables Agent.
# GEMINI_API_KEY=<server-only-provider-secret>
# CHAT_MODEL_ID=<reviewed-model-id>
# CREDENTIAL_ENCRYPTION_KEY=<canonical-base64-of-32-random-bytes>
